generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// AUTH / USER MANAGEMENT (Sprint 5-7)
// =====================================================================

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            UserProfile?
  recommendationLogs RecommendationLog[]
  chatSessions       ChatSession[]
  refreshTokens      RefreshToken[]

  @@index([email])
}

model UserProfile {
  id            Int            @id @default(autoincrement())
  userId        Int            @unique
  age           Int?
  gender        Gender?
  weight        Float? // kg
  height        Float? // cm
  activityLevel ActivityLevel?
  goal          String? // e.g. MUSCLEGAIN, WEIGHTLOSS, GENERAL_HEALTH
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique // hashed refresh token (never store raw)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecommendationLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  foodId    Int
  score     Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([foodId])
}

model ChatSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String?
  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId Int
  role      String // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// =====================================================================
// FOOD (existing)
// =====================================================================

model Food {
  id Int @id @default(autoincrement())

  // FIXED: Added ALL nutrition columns from food.csv (38 columns total)
  // These are essential for ML models (classification, recommendations, etc)

  // Basic Info
  category String?
  description String?
  nutrientDataBankNumber BigInt @unique

  // Carotenoids
  alphaCarotene Float?
  betaCarotene Float?
  betaCryptoxanthin Float?
  luteinZeaxanthin Float?
  lycopene Float?
  retinol Float?

  // Macronutrients
  carbohydrate Float?
  protein Float?
  totalLipid Float?
  sugarTotal Float?
  fiber Float?
  cholesterol Float?
  water Float?
  choline Float?

  // Monounsaturated and Polyunsaturated Fats
  monoFat Float?
  polyFat Float?
  saturatedFat Float?

  // Major Minerals
  calcium Float?
  copper Float?
  iron Float?
  magnesium Float?
  phosphorus Float?
  potassium Float?
  sodium Float?
  zinc Float?

  // Vitamins
  vitaminARae Float?
  vitaminB12 Float?
  vitaminB6 Float?
  vitaminC Float?
  vitaminE Float?
  vitaminK Float?
  niacin Float?
  riboflavin Float?
  selenium Float?
  thiamin Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recommendationLogs RecommendationLog[]
}